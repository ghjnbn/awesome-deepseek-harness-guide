{
  "config": {
    // 行长度：中文教程 + 表格/长 URL 经常超过 80 字符，不强制换行
    "MD013": false,
    // 块引用内空行：文档用空行分隔多条"提示/警告"块引用，属有意为之
    "MD028": false,
    // 有序列表编号：文中存在多段重新起算的编号列表
    "MD029": false,
    // 首行必须是 H1：PR 模板等文件有意以 H2 开头
    "MD041": false,
    // 表格列对齐样式：正文统一用 "| x |" 风格，与分隔符样式不一致属正常
    "MD060": false
  }
}
